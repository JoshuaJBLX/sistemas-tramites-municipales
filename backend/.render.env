# Variables de entorno para despliegue en Render
# COPIA ESTOS VALORES AL DASHBOARD DE RENDER después de crear tus servicios

# ============================================
# DATABASE (PostgreSQL en Render o Supabase)
# ============================================
# Opción A: Usar PostgreSQL de Render
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# Opción B: Usar Supabase (RECOMENDADO para pgvector)
# Obtén esto desde tu proyecto de Supabase -> Settings -> Database
# IMPORTANTE: Usa la URL con pooling para producción
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Si usas Supabase, también necesitas estas credenciales:
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# ============================================
# REDIS (Upstash - Render no tiene Redis gratis)
# ============================================
# Crea cuenta en upstash.com y obtén tu REST URL
REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-REDIS-HOST].upstash.io:6379
CACHE_TTL_SEGUNDOS=3600

# ============================================
# LLM (Language Model)
# ============================================
# Opción A: Usar OpenRouter (RECOMENDADO para producción)
OPENROUTER_API_KEY=[YOUR-OPENROUTER-API-KEY]
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct
# Otros modelos disponibles:
# - mistralai/mistral-7b-instruct (bueno para español)
# - meta-llama/llama-3-70b-instruct (más potente)

# Opción B: Usar Ollama local (solo para desarrollo local)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# Opción C: Usar Groq (cuando esté disponible)
# GROQ_API_KEY=[YOUR-GROQ-API-KEY]
# GROQ_MODEL=llama3-8b-8192

# ============================================
# EMBEDDINGS (BGE-M3)
# ============================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# IMPORTANTE: Agregar estas variables en el dashboard de Render para forzar torch CPU-only
# PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cpu
# TORCH_CUDA_ARCH_LIST=""
# CUDA_VISIBLE_DEVICES=""

# Opción: Usar API de embeddings (para evitar sentence-transformers pesado)
# OPENAI_API_KEY=[YOUR-OPENAI-API-KEY]
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# RAG CONFIGURACIÓN
# ============================================
RAG_TOP_K=5

# ============================================
# STORAGE (Documentos)
# ============================================
# Con Supabase Storage, no usamos path local
# DOCUMENTS_PATH=./storage/documentos  # NO USAR en producción

# Credenciales de Supabase Storage
SUPABASE_STORAGE_URL=https://[PROJECT-REF].supabase.co/storage/v1
SUPABASE_STORAGE_BUCKET=documentos

# ============================================
# FRONTEND URL (para CORS)
# ============================================
# Reemplaza con tu dominio de Vercel después de desplegar
VERCEL_FRONTEND_URL=https://tu-proyecto.vercel.app

# ============================================
# OTROS
# ============================================
PYTHON_VERSION=3.11
